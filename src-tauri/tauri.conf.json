{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vadown",
  "version": "0.3.0",
  "identifier": "com.mahmingtea.vadown",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VADown",
        "theme": "Dark",
        "width": 800,
        "height": 800,
        "titleBarStyle": "Transparent",
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/ffmpeg",
      "bin/ffprobe",
      "bin/yt-dlp"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2QzUyN0NGNjgxMTc2QUIKUldTcmRoRm96eWZGeGxxSy9UajVjVEUwVjJ5WFFSanFTNksvTUx4R2loRzhNZzN1RVliZi9qQ2cK",
      "endpoints": [
        "https://github.com/mahmingtea/vadown/releases/latest/download/latest.json"
      ]
    }
  }
}
